msgid "Updates Manager"
msgstr "Menedżer aktualizacji"

#: _meta.lua:9
msgid "Manage updates for patches and plugins GitHub repositories."
msgstr "Zarządzaj aktualizacjami łatek i wtyczek z repozytoriów GitHub."

#: main.lua
msgid "Cache cleared"
msgstr "Wyczyszczono pamięć podręczną"

#: main.lua
msgid "No cache to clear"
